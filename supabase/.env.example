# Copy to .env and fill in real values. Never commit the filled-in file (.gitignore already
# excludes .env / .env.local).

# Supplied automatically by `supabase start` / your hosted project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extraction LLM (PRD §7: "small/fast LLM, Claude Haiku class").
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Speech-to-text. Default targets OpenAI's Whisper-compatible endpoint; swap both vars to point
# at any other Whisper-API-shaped provider without touching pipeline code.
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1

# Embeddings for task dedup (voyage-3-lite is 512-dim, matching the schema's vector(512) column).
VOYAGE_API_KEY=
VOYAGE_EMBEDDINGS_MODEL=voyage-3-lite

# Tunables
FREE_DAILY_CAPTURE_LIMIT=5
DEDUP_SIMILARITY_THRESHOLD=0.86
